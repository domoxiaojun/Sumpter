# syntax=docker/dockerfile:1.7
# Fast runtime image: copies a prebuilt static sumpterd (no cargo in Docker).
# Used by .github/workflows/container.yml after cargo-zigbuild.
# Local full rebuild from source still uses ./Dockerfile.

FROM alpine:3.22 AS runtime

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 sumpter \
    && adduser -S -D -H -h /home/sumpter -u 10001 -G sumpter sumpter \
    && mkdir -p /home/sumpter /config /opt/sumpter/web \
    && chown -R 10001:10001 /home/sumpter /config /opt/sumpter \
    && chmod 0700 /home/sumpter /config

# buildx sets TARGETARCH to amd64 / arm64
ARG TARGETARCH
COPY --chmod=0755 docker-bin/sumpterd-${TARGETARCH} /usr/local/bin/sumpterd
COPY --chown=sumpter:sumpter web/ /opt/sumpter/web/
COPY --chown=sumpter:sumpter config.example.json /opt/sumpter/config.example.json

# CMD sets `--config-dir /config`, so the mounted volume must contain
# `/config/admin-password` before startup. Public access requires HTTPS.

ENV HOME=/home/sumpter \
    RUST_LOG=info \
    SUMPTER_ADMIN_HOST=127.0.0.1 \
    SUMPTER_ADMIN_PORT=57879 \
    SUMPTER_WEB_ROOT=/opt/sumpter/web

WORKDIR /opt/sumpter
USER 10001:10001
VOLUME ["/config"]
EXPOSE 57878 57879
STOPSIGNAL SIGTERM

# hadolint ignore=DL3025
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=4 \
    CMD wget -q -T 3 -O /dev/null \
      "http://127.0.0.1:$${SUMPTER_ADMIN_PORT:-57879}/healthz" \
      || exit 1

ENTRYPOINT ["/usr/local/bin/sumpterd"]
CMD ["--config-dir", "/config", "--web-root", "/opt/sumpter/web"]
