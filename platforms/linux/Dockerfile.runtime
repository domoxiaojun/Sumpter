# syntax=docker/dockerfile:1.7
# Fast runtime image: copies a prebuilt static sumpterd (no cargo in Docker).
# Built by .github/workflows/release.yml from the cargo-zigbuild binaries: the
# container job validates both architectures, the publish job pushes to GHCR.
# Local full rebuild from source still uses ./Dockerfile.

FROM alpine:3.22 AS runtime

# hadolint ignore=DL3018
RUN apk add --no-cache ca-certificates \
    && mkdir -p /config /opt/sumpter/web \
    && chmod 0700 /config

# buildx sets TARGETARCH to amd64 / arm64
ARG TARGETARCH
COPY --chmod=0755 docker-bin/sumpterd-${TARGETARCH} /usr/local/bin/sumpterd
COPY web/ /opt/sumpter/web/
COPY config.example.json /opt/sumpter/config.example.json

# Compose's init service creates missing files in the bind mount first.
# Direct docker run users must prepare /config/admin-password themselves.
# Public access requires HTTPS; CMD fixes the daemon config directory to /config.

ENV RUST_LOG=info \
    SUMPTER_ADMIN_HOST=127.0.0.1 \
    SUMPTER_ADMIN_PORT=57879 \
    SUMPTER_WEB_ROOT=/opt/sumpter/web

WORKDIR /opt/sumpter
VOLUME ["/config"]
EXPOSE 57878 57879
STOPSIGNAL SIGTERM

# hadolint ignore=DL3025
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=4 \
    CMD wget -q -T 3 -O /dev/null \
      "http://127.0.0.1:${SUMPTER_ADMIN_PORT:-57879}/healthz" \
      || exit 1

ENTRYPOINT ["/usr/local/bin/sumpterd"]
CMD ["--config-dir", "/config", "--web-root", "/opt/sumpter/web"]
