# Sumpter 代理数据面(默认 57878)的 Nginx/OpenResty 反代片段。
#
# 与 nginx-sumpter-admin.conf.example 的区别:这里反代的是客户端(Claude Code、
# Codex 等)访问的代理监听,需要长响应、SSE 与 WebSocket Upgrade。
#
# 使用方式:
#   1. 放进已有的 HTTPS `server { ... }`,替换 server_name 与后端地址。
#   2. 运行事件的「请求源 IP」按 X-Real-IP、X-Forwarded-For、TCP 对端的顺序取
#      第一个合法值,不需要预先登记代理地址。若本 Nginx 前面还有 CDN、负载均衡等
#      更多层,把这些已知代理填进 Sumpter 的 listener.trustedProxyCIDRs,
#      X-Forwarded-For 链就会从右向左跳过它们。
#   3. 入站 Token 与 allowedCIDRs 仍按 Sumpter 看到的 TCP 对端(本 Nginx)判定;
#      需要限制客户端网段时请在 Nginx 用 allow/deny,或让 allowedCIDRs 只包含代理。
#
# 本 Nginx 直接面对客户端,所以 X-Forwarded-For / X-Real-IP 都用 $remote_addr
# 覆盖,丢弃客户端自带的值。若本 Nginx 前面还有一层代理(CDN、负载均衡),
# 改为 $proxy_add_x_forwarded_for 追加链路,并把前一层加入 trustedProxyCIDRs。

# 长 SSE / WebSocket 会话不应因为默认 60s 读超时被切断。
map $http_upgrade $sumpter_connection_upgrade {
    default upgrade;
    ""      "";
}

location / {
    proxy_pass http://127.0.0.1:57878;
    proxy_http_version 1.1;

    # WebSocket(Responses / Realtime)与普通 HTTP 共用同一 location。
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $sumpter_connection_upgrade;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 流式响应逐块透传;请求体默认已由 Nginx 缓冲,64 MiB 与 Sumpter 的上限一致。
    proxy_buffering off;
    proxy_cache off;
    proxy_request_buffering on;
    client_max_body_size 64m;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
}
