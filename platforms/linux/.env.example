# 可选：复制为 .env 才生效；不复制时 compose.yaml 的全部默认值同样可用。
# 此文件不是 Shell 脚本，不要 source。下面未列出的变量会通过 env_file 原样透传给 daemon。
COMPOSE_PROJECT_NAME=sumpter
# 官方发布镜像（Release 工作流构建并推送的双架构 manifest）。
# 钉死版本：ghcr.io/domoxiaojun/sumpter:0.4.6（tag 不带 v）；也可用 digest。
# 本机源码构建使用独立的 SUMPTER_LOCAL_IMAGE，不会复用这个变量。
SUMPTER_IMAGE=ghcr.io/domoxiaojun/sumpter:latest

# 数据目录，相对于 compose.yaml 所在目录。保持相对路径，迁移才能只复制整个目录。
SUMPTER_CONFIG_DIR=./config

# 宿主机发布地址与端口（不是容器内监听地址/端口，见 DOCKER.md 的“宿主机侧 vs 容器内”）：
# 代理与 Admin 是两个独立监听项，不是重复配置：
#   代理 = 数据面，客户端 API 流量（OpenAI / Anthropic / Codex 等）
#   Admin = 控制面，WebUI 与 /admin/api
# 默认仅本机访问；对外开放前先在 WebUI 设置入站 Token/CIDR，Admin 使用 HTTPS 反代。
SUMPTER_PROXY_BIND_HOST=127.0.0.1
SUMPTER_PROXY_PORT=57878
SUMPTER_ADMIN_BIND_HOST=127.0.0.1
SUMPTER_ADMIN_PORT=57879

# daemon 日志等级或过滤器（程序读取 RUST_LOG）。
RUST_LOG=info
# 容器时区；镜像已安装 tzdata（v0.4.5 及更早的发布镜像没有），这里才生效。
# 程序自身的统计与时间戳仍按 Unix 时间（UTC）存储，日志时间戳也是 UTC，
# WebUI 按浏览器时区展示；TZ 主要影响容器内其他工具与诊断输出。
TZ=UTC
SUMPTER_RESTART_POLICY=unless-stopped
SUMPTER_STOP_GRACE_PERIOD=30s
SUMPTER_TMPFS_SIZE=64m
SUMPTER_LOG_MAX_SIZE=10m
SUMPTER_LOG_MAX_FILES=3

# ---------------------------------------------------------------------------
# 可选：仅用于排查，出现 panic 时给报告附上回溯
# RUST_BACKTRACE=1
#
# 以下变量在本部署里无效或必须保持默认，设置会破坏容器契约，不要写进来：
#   SUMPTER_WEB_ROOT          CMD 的 --web-root /opt/sumpter/web 优先，改了会被忽略；
#                             WebUI 由镜像提供，换成宿主机目录没有意义
#   SUMPTER_ADMIN_HOST        compose.yaml 固定为 0.0.0.0（bridge 下必须）
#   SUMPTER_ADMIN_PORT        compose.yaml 固定为 57879（健康检查与端口映射都依赖它）
#   SUMPTER_ADMIN_PASSWORD_FILE  固定为 /config/admin-password
#   HTTP_PROXY / HTTPS_PROXY / ALL_PROXY / NO_PROXY
#                             引擎的数据面与模型目录探测都显式 `.no_proxy()`，
#                             上游转发不会走环境代理；只会在目录探测失败时
#                             被识别出来并附一句说明（不回显变量值）。没有可用代理，
#                             NO_PROXY 也无豁免对象，同样不要写。
#   HOME / XDG_CONFIG_HOME    CMD 已用 --config-dir /config 固定，不再参与推导
# 初始密码由 init 服务生成到 config/admin-password，不在这里填写，也不要用环境变量传密码。
# 上游入口、模型组、Token/CIDR 属于 config.json，由 WebUI 管理；这里多写同名字段不会生效。
# ---------------------------------------------------------------------------
